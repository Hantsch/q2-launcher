{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "ignorePatterns": ["out/", "dist/", "release/", "node_modules/", "vendor/"],
  "categories": { "correctness": "error" },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-unused-vars": "error",
    // React-compiler rules stay off until the compiler refactor lands (story 213).
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/globals": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/static-components": "off",
    // stylistic rules, deliberately off.
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/prefer-string-starts-ends-with": "off"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "node:*",
              "electron",
              "@main/*",
              "@renderer/*",
              "**/main/**",
              "**/renderer/**"
            ],
            "paths": [
              "_http_agent",
              "_http_client",
              "_http_common",
              "_http_incoming",
              "_http_outgoing",
              "_http_server",
              "_stream_duplex",
              "_stream_passthrough",
              "_stream_readable",
              "_stream_transform",
              "_stream_wrap",
              "_stream_writable",
              "_tls_common",
              "_tls_wrap",
              "assert",
              "assert/strict",
              "async_hooks",
              "buffer",
              "child_process",
              "cluster",
              "console",
              "constants",
              "crypto",
              "dgram",
              "diagnostics_channel",
              "dns",
              "dns/promises",
              "domain",
              "events",
              "fs",
              "fs/promises",
              "http",
              "http2",
              "https",
              "inspector",
              "inspector/promises",
              "module",
              "net",
              "os",
              "path",
              "path/posix",
              "path/win32",
              "perf_hooks",
              "process",
              "punycode",
              "querystring",
              "readline",
              "readline/promises",
              "repl",
              "stream",
              "stream/consumers",
              "stream/promises",
              "stream/web",
              "string_decoder",
              "sys",
              "timers",
              "timers/promises",
              "tls",
              "trace_events",
              "tty",
              "url",
              "util",
              "util/types",
              "v8",
              "vm",
              "wasi",
              "worker_threads",
              "zlib"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/renderer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["node:*", "electron", "@main/*", "**/main/**"],
            "paths": [
              "_http_agent",
              "_http_client",
              "_http_common",
              "_http_incoming",
              "_http_outgoing",
              "_http_server",
              "_stream_duplex",
              "_stream_passthrough",
              "_stream_readable",
              "_stream_transform",
              "_stream_wrap",
              "_stream_writable",
              "_tls_common",
              "_tls_wrap",
              "assert",
              "assert/strict",
              "async_hooks",
              "buffer",
              "child_process",
              "cluster",
              "console",
              "constants",
              "crypto",
              "dgram",
              "diagnostics_channel",
              "dns",
              "dns/promises",
              "domain",
              "events",
              "fs",
              "fs/promises",
              "http",
              "http2",
              "https",
              "inspector",
              "inspector/promises",
              "module",
              "net",
              "os",
              "path",
              "path/posix",
              "path/win32",
              "perf_hooks",
              "process",
              "punycode",
              "querystring",
              "readline",
              "readline/promises",
              "repl",
              "stream",
              "stream/consumers",
              "stream/promises",
              "stream/web",
              "string_decoder",
              "sys",
              "timers",
              "timers/promises",
              "tls",
              "trace_events",
              "tty",
              "url",
              "util",
              "util/types",
              "v8",
              "vm",
              "wasi",
              "worker_threads",
              "zlib"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      // createElement's typed props require `children` as a prop; there is no JSX in the .ts tests.
      "rules": { "no-restricted-imports": "off", "react/no-children-prop": "off" }
    }
  ]
}
