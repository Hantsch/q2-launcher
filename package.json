{
  "name": "q2-launcher",
  "productName": "Q2 Launcher",
  "version": "0.1.0",
  "description": "A modern launcher for Quake II, built around the r1q2 client.",
  "license": "MIT",
  "author": {
    "name": "Hantsch"
  },
  "homepage": "https://github.com/Hantsch/q2-launcher",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/generate-icon.mjs",
    "ui:seed": "node scripts/seed.mjs",
    "ui:shot": "node scripts/verify.mjs --skip-axe",
    "ui:a11y": "node scripts/verify.mjs --skip-shot",
    "ui:verify": "node scripts/ui-verify.mjs",
    "ui:flow": "node scripts/flow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:dir": "npm run icon && npm run build && electron-builder --dir --config electron-builder.yml",
    "package:win": "npm run icon && npm run typecheck && npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  }
}
