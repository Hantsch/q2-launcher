From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Q2 Launcher <engine@q2launcher.invalid>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 9/9] web: integrated canvas host, keys, size and exports

The engine draws into the launcher's #q2l-engine-canvas, takes keys only from it and never requests pointer lock or sizes the canvas itself. The host resizes the canvas and calls q2l_resize; ccall, pauseMainLoop and resumeMainLoop are exported.
---
 meson.build                 |  4 ++--
 src/unix/video/emscripten.c | 30 +++++++++++++++++-------------
 2 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/meson.build b/meson.build
index a8c345a..c08e3fe 100644
--- a/meson.build
+++ b/meson.build
@@ -685,8 +685,8 @@ if web
     '-sALLOW_MEMORY_GROWTH=1',
     '-sINITIAL_MEMORY=128MB',
     '-sMAXIMUM_MEMORY=2GB',
-    '-sEXPORTED_FUNCTIONS=_main,_q2l_step,_q2l_seed,_q2l_frames_rendered,_q2l_audio_take,_q2l_audio_consumed,_q2l_audio_capture,_malloc,_free',
-    '-sEXPORTED_RUNTIME_METHODS=FS,cwrap,HEAPU8,HEAP16',
+    '-sEXPORTED_FUNCTIONS=_main,_q2l_step,_q2l_seed,_q2l_frames_rendered,_q2l_audio_take,_q2l_audio_consumed,_q2l_audio_capture,_malloc,_free,_q2l_resize',
+    '-sEXPORTED_RUNTIME_METHODS=FS,cwrap,ccall,pauseMainLoop,resumeMainLoop,HEAPU8,HEAP16',
     '--profiling-funcs',
   ]
 
diff --git a/src/unix/video/emscripten.c b/src/unix/video/emscripten.c
index 717cb52..a55ccd3 100644
--- a/src/unix/video/emscripten.c
+++ b/src/unix/video/emscripten.c
@@ -27,10 +27,12 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 #include "refresh/refresh.h"
 #include "system/system.h"
 
+#include <emscripten.h>
 #include <emscripten/html5.h>
 #include <emscripten/html5_webgl.h>
 
-#define TARGET  "canvas"
+// The launcher owns this element: it sizes it and takes keys only from it.
+#define TARGET  "#q2l-engine-canvas"
 
 static struct {
     EMSCRIPTEN_WEBGL_CONTEXT_HANDLE context;
@@ -75,10 +77,6 @@ static bool canvas_resized_cb(int type, const void *reserved, void *data)
 
 static bool window_resized_cb(int type, const EmscriptenUiEvent *event, void *data)
 {
-    double w, h, scale = emscripten_get_device_pixel_ratio();
-    emscripten_get_element_css_size(TARGET, &w, &h);
-    emscripten_set_canvas_element_size(TARGET, w * scale, h * scale);
-
     mode_changed();
     return false;
 }
@@ -151,9 +149,6 @@ static bool mousedown_cb(int type, const EmscriptenMouseEvent *event, void *data
     if (event->button >= q_countof(keys))
         return false;
 
-    if (htm.mouse.grabbed && !htm.mouse.pointerlocked)
-        emscripten_request_pointerlock(TARGET, false);
-
     Key_Event(keys[event->button], type == EMSCRIPTEN_EVENT_MOUSEDOWN, event->timestamp);
     return true;
 }
@@ -243,8 +238,8 @@ static bool init(void)
         return false;
     }
 
-    emscripten_set_keydown_callback          (EMSCRIPTEN_EVENT_TARGET_WINDOW, NULL, true, keydown_cb);
-    emscripten_set_keyup_callback            (EMSCRIPTEN_EVENT_TARGET_WINDOW, NULL, true, keydown_cb);
+    emscripten_set_keydown_callback          (TARGET, NULL, true, keydown_cb);
+    emscripten_set_keyup_callback            (TARGET, NULL, true, keydown_cb);
     emscripten_set_resize_callback           (EMSCRIPTEN_EVENT_TARGET_WINDOW, NULL, true, window_resized_cb);
     emscripten_set_pointerlockchange_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, NULL, true, pointerlock_change_cb);
     emscripten_set_focus_callback            (EMSCRIPTEN_EVENT_TARGET_WINDOW, NULL, true, focus_cb);
@@ -308,14 +303,18 @@ static void grab_mouse(bool grab)
     if (!htm.mouse.initialized)
         return;
 
-    if (grab)
-        emscripten_request_pointerlock(TARGET, false);
-    else
+    if (!grab)
         emscripten_exit_pointerlock();
 
     htm.mouse.grabbed = grab;
 }
 
+// The host resizes the canvas; the engine only re-reads its drawing buffer.
+EMSCRIPTEN_KEEPALIVE void q2l_resize(void)
+{
+    mode_changed();
+}
+
 static bool probe(void)
 {
     return true;
