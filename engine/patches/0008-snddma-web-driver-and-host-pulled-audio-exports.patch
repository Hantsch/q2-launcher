+
+// Software sound driver for the web build: the mixer paints S16LE stereo into
+// a ring the host pulls from, instead of a device pulling from it. (story 286)
+//
+// DMA_Update paints up to DMA_GetTime() + mixahead, and DMA_GetTime() is
+// samplepos / 2 plus one ring per observed wrap (samplepos smaller than last
+// seen). So the play position written here alone decides how far the mixer
+// paints:
+// - real time: the host reports how many frames it has consumed;
+// - capture: each step advances samplepos by exactly speed * msec / 1000
+//   frames (remainder carried), and with s_mixahead 0 and the client forced
+//   active (no 0.125 s floor) s_paintedtime ends every step equal to the play
+//   position. A step must stay below one ring (0x8000 frames, ~682 ms at
+//   48 kHz), or DMA_GetTime cannot see the wrap.
+
+#include "shared/shared.h"
+#include "common/common.h"
+#include "common/zone.h"
+#include "client/client.h"
+#include "client/sound/sound.h"
+#include "client/sound/dma.h"
+
+#include <emscripten.h>
+
+#define RING_FRAMES 0x8000
+
+static bool     started;
+static bool     capturing;
+static int      taken;          // stereo frames already handed to the host
+static int      target;         // s_paintedtime a capture step must reach
+static unsigned frame_rest;     // speed * msec not yet turned into a frame
+
+static sndinitstat_t Init(void)
+{
+    switch (s_khz->integer) {
+    case 48:
+        dma.speed = 48000;
+        break;
+    case 44:
+        dma.speed = 44100;
+        break;
+    case 22:
+        dma.speed = 22050;
+        break;
+    default:
+        dma.speed = 11025;
+        break;
+    }
+
+    dma.channels = 2;
+    dma.samples = RING_FRAMES * 2;
+    dma.submission_chunk = 1;
+    dma.samplebits = 16;
+    dma.buffer = Z_Mallocz(dma.samples * 2);
+    dma.samplepos = 0;
+
+    started = true;
+    capturing = false;
+    taken = target = 0;
+    frame_rest = 0;
+
+    Com_Printf("Using web audio driver (host-pulled ring, %d Hz).\n", dma.speed);
+
+    return SIS_SUCCESS;
+}
+
+static void Shutdown(void)
+{
+    Com_Printf("Shutting down web audio.\n");
+
+    started = capturing = false;
+    Z_Freep(&dma.buffer);
+}
+
+static void BeginPainting(void)
+{
+}
+
+static void Submit(void)
+{
+}
+
+const snddma_driver_t snddma_web = {
+    .name = "web",
+    .init = Init,
+    .shutdown = Shutdown,
+    .begin_painting = BeginPainting,
+    .submit = Submit,
+};
+
+/*
+=================
+q2l_audio_take
+
+Copies painted stereo frames [taken, s_paintedtime) into dst, at most
+maxFrames, and returns how many. Only the last ring's worth is still intact.
+=================
+*/
+EMSCRIPTEN_KEEPALIVE int q2l_audio_take(int16_t *dst, int maxFrames)
+{
+    const int16_t *ring = (const int16_t *)dma.buffer;
+    int count, pos, first;
+
+    if (!started || maxFrames <= 0)
+        return 0;
+
+    // s_paintedtime goes back when DMA_GetTime chops it near 2^30.
+    if (taken > s_paintedtime)
+        taken = s_paintedtime;
+    else if (s_paintedtime - taken > RING_FRAMES)
+        taken = s_paintedtime - RING_FRAMES;
+
+    count = min(s_paintedtime - taken, maxFrames);
+    pos = taken & (RING_FRAMES - 1);
+    first = min(count, RING_FRAMES - pos);
+
+    memcpy(dst, ring + pos * 2, first * 4);
+    memcpy(dst + first * 2, ring, (count - first) * 4);
+
+    taken += count;
+    return count;
+}
+
+/*
+=================
+q2l_audio_consumed
+
+Real-time play position: total stereo frames the host has played. Ignored
+while capturing, where steps own the play position.
+=================
+*/
+EMSCRIPTEN_KEEPALIVE void q2l_audio_consumed(int frames)
+{
+    if (!started || capturing)
+        return;
+
+    dma.samplepos = ((unsigned)frames * 2) % dma.samples;
+}
+
+/*
+=================
+q2l_audio_capture
+
+Turning capture on drops everything painted so far and moves the play
+position onto s_paintedtime. After any DMA_Update s_paintedtime lies less
+than one ring ahead of the time last seen, so the next DMA_GetTime returns
+exactly s_paintedtime and the first step paints only its own frames.
+=================
+*/
+EMSCRIPTEN_KEEPALIVE void q2l_audio_capture(int on)
+{
+    if (!started)
+        return;
+
+    capturing = on != 0;
+    if (!capturing)
+        return;
+
+    taken = target = s_paintedtime;
+    frame_rest = 0;
+    dma.samplepos = (s_paintedtime & (RING_FRAMES - 1)) * 2;
+}
+
+void snddma_web_step(unsigned msec)
+{
+    if (!started || !capturing)
+        return;
+
+    CL_Activate(ACT_ACTIVATED);
+    // cls.active may already be ACT_ACTIVATED from before the mixer started, which makes
+    // CL_Activate a no-op and leaves s_active false, so every S_StartSound would be dropped.
+    S_Activate();
+
+    frame_rest += (unsigned)dma.speed * msec;
+    target += frame_rest / 1000;
+    frame_rest %= 1000;
+}
+
+// While capturing, the mixer paints up to the step's end time although the play position
+// still sits at the step's start: with the play position already at the end, DMA_Update would
+// snap s_paintedtime onto it and paint nothing.
+int snddma_web_paint_to(int endtime)
+{
+    return started && capturing ? target : endtime;
+}
+
+// CL_Frame mixes only on frames it renders (or while minimized); mixing here as
+// well keeps every step's frames painted within that step. The play position moves to
+// the step's end only afterwards, so the next step's mix starts at s_paintedtime.
+void snddma_web_settle(void)
+{
+    if (!started || !capturing)
+        return;
+
+    if (s_paintedtime != target)
+        S_Update();
+
+    dma.samplepos = (target & (RING_FRAMES - 1)) * 2;
+}
