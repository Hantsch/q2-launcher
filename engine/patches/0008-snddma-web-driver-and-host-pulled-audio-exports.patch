@@ -47,3 +47,10 @@ extern dma_t    dma;
 extern int      s_paintedtime;
 
 extern cvar_t   *s_khz;
+
+#ifdef __EMSCRIPTEN__
+// Called by q2l_step around CL_Frame; no-ops unless capture is on.
+void snddma_web_step(unsigned msec);
+void snddma_web_settle(void);
+int snddma_web_paint_to(int endtime);
+#endif
