 };
@@ -845,7 +852,12 @@ static void DMA_Update(void)
     sec = Cvar_ClampValue(s_mixahead, 0, 1);
     if (!cls.active)
         sec = max(sec, 0.125f);
-    endtime = soundtime + sec * dma.speed;
+    // Integer sum: as a float, soundtime past 2^24 frames would round, and the
+    // paint-to time would no longer advance by exactly the play position.
+    endtime = soundtime + (int)(sec * dma.speed);
+#ifdef __EMSCRIPTEN__
+    endtime = snddma_web_paint_to(endtime);
+#endif
 
     // mix to an even submission block size
     endtime = Q_ALIGN(endtime, dma.submission_chunk);
