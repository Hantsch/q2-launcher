index 229710f..5edb4f7 100644
--- a/src/client/sound/dma.c
+++ b/src/client/sound/dma.c
@@ -528,6 +528,10 @@ extern const snddma_driver_t    snddma_wave;
 extern const snddma_driver_t    snddma_sdl;
 #endif
 
+#ifdef __EMSCRIPTEN__
+extern const snddma_driver_t    snddma_web;
