@@ -682,7 +685,7 @@ if web
     '-sALLOW_MEMORY_GROWTH=1',
     '-sINITIAL_MEMORY=128MB',
     '-sMAXIMUM_MEMORY=2GB',
-    '-sEXPORTED_FUNCTIONS=_main,_q2l_step,_q2l_seed,_q2l_frames_rendered',
+    '-sEXPORTED_FUNCTIONS=_main,_q2l_step,_q2l_seed,_q2l_frames_rendered,_q2l_audio_take,_q2l_audio_consumed,_q2l_audio_capture,_malloc,_free',
     '-sEXPORTED_RUNTIME_METHODS=FS,cwrap,HEAPU8,HEAP16',
