+
+// Deterministic stepping for the launcher: the host decides how much time a
+// frame covers, so the same demo and the same step sequence give the same
+// frames. The emscripten_set_main_loop real-time path is left untouched; the
+// host pauses it before stepping. (story 285)
+
+#include "shared/shared.h"
+#include "common/async.h"
+#include "common/common.h"
+#include "common/cvar.h"
+#include "common/net/net.h"
+#include "client/client.h"
+#include "server/server.h"
+#include "system/system.h"
+
+#include <emscripten.h>
+
+/*
+=================
+q2l_step
+
+The body of Qcommon_Frame around the msec computation. Real time (NET_Sleep,
+Sys_Milliseconds, the busy-wait, the hitch clamp) and fixedtime/timescale are
+left out: they would make the frame length depend on the host clock.
+=================
+*/
+EMSCRIPTEN_KEEPALIVE void q2l_step(int ms)
+{
+    unsigned msec = ms;
+
+    // Com_Error(ERR_DROP) longjmps here; the jump target must be a frame that
+    // is still on the stack, so every entry point sets it like Qcommon_Frame.
+    if (setjmp(com_abortframe)) {
+        return;
+    }
+
+    Com_CompleteAsyncWork();
+
+    com_localTime += msec;
+    com_localTime2 += msec & (sv_paused->integer - 1);
+    com_framenum++;
+
+    Sys_RunConsole();
+
+    NET_UpdateStats();
+
+    SV_Frame(msec);
+
+    CL_Frame(msec);
+}
+
+EMSCRIPTEN_KEEPALIVE void q2l_seed(int seed)
+{
+    Q_srand(seed);
+}
+
+EMSCRIPTEN_KEEPALIVE int q2l_frames_rendered(void)
+{
+    return com_framesRendered;
+}
