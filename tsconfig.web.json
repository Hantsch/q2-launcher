{
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.json",
    "src/shared/**/*.ts",
    "src/preload/index.d.ts"
  ],
  // Story 081 D3: `shell-home-ownership.test.ts` walks the filesystem with `node:fs`/`node:path`/
  // `node:url` to guard against a shell/views file re-importing a home component - a Node-only
  // capability the renderer project has no `types: ["node"]` for by design (docs/ARCHITECTURE.md).
  // It typechecks under `tsconfig.node.json` instead (mirrors that project's own explicit
  // cross-reference to `i18n/locales/en.json`), so it is excluded here rather than pulling `node`
  // types into every renderer file.
  // Story 107 D1: `address.test.ts`'s purity check reads `address.ts`'s own source with
  // `node:fs`/`node:path`/`node:url` to assert it stays free of node/electron/IPC imports - the
  // same node-only-capability shape as `shell-home-ownership.test.ts` above, so it is excluded
  // here and typechecks under `tsconfig.node.json` instead (`src/shared/**/*.ts` already covers it
  // there).
  // Story 108 D1: `protocol.test.ts`'s purity sweep does the same thing over every non-test file
  // in `src/shared/servers/`, for the same reason - excluded here, typechecks under
  // `tsconfig.node.json` instead.
  "exclude": [
    "src/renderer/src/components/shell/shell-home-ownership.test.ts",
    "src/shared/servers/address.test.ts",
    "src/shared/servers/protocol.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/types/web",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo/web.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
