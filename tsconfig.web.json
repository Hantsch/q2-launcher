{
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.json",
    "src/shared/**/*.ts",
    "src/shared/fixture-constants.json",
    "src/test-support/fixtures.ts",
    "src/preload/index.d.ts"
  ],
  // Story 172 D1: `demo-guard.test.ts` drives the node-side command-buffer simulator
  // (`src/test-support/q2-cbuf-sim.ts`), which only the node project includes - so it is excluded
  // here and typechecks under `tsconfig.node.json` instead (`src/shared/**/*.ts` covers it there).
  // `common.test.ts` reads docs/ARCHITECTURE.md with `node:fs` (node-only), so it typechecks under
  // `tsconfig.node.json` only.
  // `lib/toast.test.ts` scans the renderer sources with `node:fs` (node-only), so it is excluded here
  // too.
  "exclude": [
    "src/shared/replays/demo-guard.test.ts",
    "src/shared/fixture-constants.test.ts",
    "src/shared/types/common.test.ts",
    "src/renderer/src/lib/toast.test.ts",
    "src/renderer/src/i18n/reason-templates.test.ts",
    "src/test-support/source-files.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/types/web",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuildinfo/web.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
